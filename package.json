{
  "name": "shieldedsol",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "db:init": "node db/init.js",
    "db:check": "node db/check.js",
    "db:clear": "node db/clear.js",
    "cron:test": "./test-cron.sh",
    "build:cf": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "deploy": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@fontsource/inter": "^5.2.8",
    "@libsql/client": "^0.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.95.0",
    "@vercel/og": "^0.8.6",
    "canvas": "^3.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "0.25.4",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.14.0",
    "sharp": "^0.34.5",
    "thinking-orbs": "^0.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.5.0",
    "wrangler": "^4.114.0"
  }
}
